#cloud-config
autoinstall:
  version: 1
  identity:
    hostname: ${jsonencode(hostname)}
    username: ${jsonencode(username)}
    password: ${jsonencode(password_hash)}
  ssh:
    install-server: true
    allow-pw: false
    authorized-keys:
      - ${jsonencode(ssh_public_key)}
  storage:
    layout:
      name: direct
  updates: security
